<?xml version="1.0" encoding="utf-8"?>
<!-- The database holds where the phone has been, so none of it goes to a cloud backup. A cable or
     wireless transfer to a new phone, which the person starts themselves, takes everything along. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
