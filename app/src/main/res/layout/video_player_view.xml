<?xml version="1.0" encoding="utf-8"?>
<!-- The video is drawn on a texture, not a surface of its own: a surface behind the window stayed black
     while the video played whenever the player was added inside the pager, until the view was laid out again. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/transparent" />
